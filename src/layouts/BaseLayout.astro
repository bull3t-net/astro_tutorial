---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import type { PageMetadata } from "../data/site";
interface Props {
  page: PageMetadata;
  showHero?: boolean;
  showClosing?: boolean;
  reading?: boolean;
}
const { page, showHero = true, showClosing = true, reading = false } = Astro.props;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#073d34" />
    <title>{page.path === '/' ? 'Cardistry — Offline NFC & PVC Business Cards' : `${page.title} | Cardistry`}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={new URL(page.path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${page.title} | Cardistry`} />
    <meta property="og:description" content={page.description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://cardistry.co.za/assets/cardistry-wordmark.png"
    />
  </head>
  <body>
    <Header activePage={page.path.split("/")[1] || "home"} />
    <main id="main">
      {showHero && <PageHero page={page} reading={reading} />}
      <slot />
      {showClosing && <ClosingCTA />}
    </main>
    <Footer />
  </body>
</html>

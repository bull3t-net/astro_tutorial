---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pages } from "../data/site";
import Hero from "../components/home/Hero.astro";
import Benefits from "../components/home/Benefits.astro";
import Difference from "../components/home/Difference.astro";
import Collection from "../components/home/Collection.astro";
import Statement from "../components/home/Statement.astro";
import FaqPreview from "../components/home/FaqPreview.astro";
import Journal from "../components/home/Journal.astro";
---

<BaseLayout page={pages.home} showHero={false}>
  <Hero />
  <Benefits />
  <Difference />
  <Statement />
  <Collection />
  <FaqPreview />
  <Journal />
</BaseLayout>
